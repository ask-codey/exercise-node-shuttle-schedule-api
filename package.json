{
  "name": "shuttle-schedule-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js | pino-pretty",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.9.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "9.0.8",
      "disablePostinstall": "true",
      "systemBinaryVersionCheck": "false"
    }
  }
}
